        "magento/module-indexer": "*",
        "magento/module-mysql-mq": "*",
        "magento/module-review": "*",
        "magento/module-sales": "*",
        "magento/module-shipping": "*",
        "magento/module-store": "*",
        "magento/module-user": "*",
        "zerofront/module-zero-cms": "^1.3.10"

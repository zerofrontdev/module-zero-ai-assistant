<?xml version="1.0"?>
<!--
    Copyright © 2026 Roman Pasichnyk
    SPDX-License-Identifier: OSL-3.0 OR AFL-3.0

    The assistant's tools. Another module adds its own here (an item
    implementing Model\Tool\ToolInterface); the role's ACL decides who gets it.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Zero\AiAssistant\Model\Tools">
        <arguments>
            <argument name="tools" xsi:type="array">
                <item name="search_products" xsi:type="object" sortOrder="10">Zero\AiAssistant\Model\Tool\Catalog\SearchProducts</item>
                <item name="get_product" xsi:type="object" sortOrder="20">Zero\AiAssistant\Model\Tool\Catalog\GetProduct</item>
                <item name="create_product" xsi:type="object" sortOrder="30">Zero\AiAssistant\Model\Tool\Catalog\CreateProduct</item>
                <item name="update_product" xsi:type="object" sortOrder="40">Zero\AiAssistant\Model\Tool\Catalog\UpdateProduct</item>
                <item name="bulk_write_products" xsi:type="object" sortOrder="50">Zero\AiAssistant\Model\Tool\Catalog\BulkWriteProducts</item>
                <item name="list_categories" xsi:type="object" sortOrder="60">Zero\AiAssistant\Model\Tool\Catalog\ListCategories</item>
                <item name="save_category" xsi:type="object" sortOrder="70">Zero\AiAssistant\Model\Tool\Catalog\SaveCategory</item>
                <item name="search_cms_pages" xsi:type="object" sortOrder="80">Zero\AiAssistant\Model\Tool\Cms\SearchPages</item>
                <item name="get_cms_page" xsi:type="object" sortOrder="90">Zero\AiAssistant\Model\Tool\Cms\GetPage</item>
                <item name="save_cms_page" xsi:type="object" sortOrder="100">Zero\AiAssistant\Model\Tool\Cms\SavePage</item>
                <item name="search_cms_blocks" xsi:type="object" sortOrder="110">Zero\AiAssistant\Model\Tool\Cms\SearchBlocks</item>
                <item name="get_cms_block" xsi:type="object" sortOrder="120">Zero\AiAssistant\Model\Tool\Cms\GetBlock</item>
                <item name="save_cms_block" xsi:type="object" sortOrder="130">Zero\AiAssistant\Model\Tool\Cms\SaveBlock</item>
                <item name="list_orders" xsi:type="object" sortOrder="140">Zero\AiAssistant\Model\Tool\Sales\ListOrders</item>
                <item name="get_order" xsi:type="object" sortOrder="150">Zero\AiAssistant\Model\Tool\Sales\GetOrder</item>
                <item name="invoice_order" xsi:type="object" sortOrder="160">Zero\AiAssistant\Model\Tool\Sales\InvoiceOrder</item>
                <item name="ship_order" xsi:type="object" sortOrder="170">Zero\AiAssistant\Model\Tool\Sales\ShipOrder</item>
                <item name="comment_order" xsi:type="object" sortOrder="180">Zero\AiAssistant\Model\Tool\Sales\CommentOrder</item>
                <item name="hold_order" xsi:type="object" sortOrder="190">Zero\AiAssistant\Model\Tool\Sales\HoldOrder</item>
                <item name="unhold_order" xsi:type="object" sortOrder="200">Zero\AiAssistant\Model\Tool\Sales\UnholdOrder</item>
                <item name="cancel_order" xsi:type="object" sortOrder="210">Zero\AiAssistant\Model\Tool\Sales\CancelOrder</item>
                <item name="store_status" xsi:type="object" sortOrder="220">Zero\AiAssistant\Model\Tool\System\Status</item>
                <item name="flush_cache" xsi:type="object" sortOrder="230">Zero\AiAssistant\Model\Tool\System\FlushCache</item>
                <item name="reindex" xsi:type="object" sortOrder="240">Zero\AiAssistant\Model\Tool\System\Reindex</item>
                <item name="get_settings" xsi:type="object" sortOrder="250">Zero\AiAssistant\Model\Tool\System\GetSettings</item>
                <item name="set_settings" xsi:type="object" sortOrder="260">Zero\AiAssistant\Model\Tool\System\SetSettings</item>
                <!-- Zero_Cms is a hard dependency (module.xml): \Proxy and `requires` keep these unbuilt while it is off. -->
                <item name="list_cms_components" xsi:type="object" sortOrder="1110">Zero\AiAssistant\Model\Tool\Cms\ListComponents\Proxy</item>
                <item name="get_cms_components" xsi:type="object" sortOrder="1120">Zero\AiAssistant\Model\Tool\Cms\GetComponents\Proxy</item>
                <item name="save_cms_components" xsi:type="object" sortOrder="1130">Zero\AiAssistant\Model\Tool\Cms\SaveComponents\Proxy</item>
            </argument>
            <argument name="requires" xsi:type="array">
                <item name="list_cms_components" xsi:type="string">Zero_Cms</item>
                <item name="get_cms_components" xsi:type="string">Zero_Cms</item>
                <item name="save_cms_components" xsi:type="string">Zero_Cms</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="Zero\AiAssistant\Model\Tool\Cms\SearchPages" type="Zero\AiAssistant\Model\Tool\Cms\SearchContent">
        <arguments><argument name="type" xsi:type="string">page</argument></arguments>
    </virtualType>
    <virtualType name="Zero\AiAssistant\Model\Tool\Cms\GetPage" type="Zero\AiAssistant\Model\Tool\Cms\GetContent">
        <arguments><argument name="type" xsi:type="string">page</argument></arguments>
    </virtualType>
    <virtualType name="Zero\AiAssistant\Model\Tool\Cms\SavePage" type="Zero\AiAssistant\Model\Tool\Cms\SaveContent">
        <arguments><argument name="type" xsi:type="string">page</argument></arguments>
    </virtualType>
    <virtualType name="Zero\AiAssistant\Model\Tool\Cms\SearchBlocks" type="Zero\AiAssistant\Model\Tool\Cms\SearchContent">
        <arguments><argument name="type" xsi:type="string">block</argument></arguments>
    </virtualType>
    <virtualType name="Zero\AiAssistant\Model\Tool\Cms\GetBlock" type="Zero\AiAssistant\Model\Tool\Cms\GetContent">
        <arguments><argument name="type" xsi:type="string">block</argument></arguments>
    </virtualType>
    <virtualType name="Zero\AiAssistant\Model\Tool\Cms\SaveBlock" type="Zero\AiAssistant\Model\Tool\Cms\SaveContent">
        <arguments><argument name="type" xsi:type="string">block</argument></arguments>
    </virtualType>
    <virtualType name="Zero\AiAssistant\Model\Tool\Sales\InvoiceOrder" type="Zero\AiAssistant\Model\Tool\Sales\OrderAction">
        <arguments><argument name="action" xsi:type="string">invoice</argument></arguments>
    </virtualType>
    <virtualType name="Zero\AiAssistant\Model\Tool\Sales\ShipOrder" type="Zero\AiAssistant\Model\Tool\Sales\OrderAction">
        <arguments><argument name="action" xsi:type="string">ship</argument></arguments>
    </virtualType>
    <virtualType name="Zero\AiAssistant\Model\Tool\Sales\CommentOrder" type="Zero\AiAssistant\Model\Tool\Sales\OrderAction">
        <arguments><argument name="action" xsi:type="string">comment</argument></arguments>
    </virtualType>
    <virtualType name="Zero\AiAssistant\Model\Tool\Sales\HoldOrder" type="Zero\AiAssistant\Model\Tool\Sales\OrderAction">
        <arguments><argument name="action" xsi:type="string">hold</argument></arguments>
    </virtualType>
    <virtualType name="Zero\AiAssistant\Model\Tool\Sales\UnholdOrder" type="Zero\AiAssistant\Model\Tool\Sales\OrderAction">
        <arguments><argument name="action" xsi:type="string">unhold</argument></arguments>
    </virtualType>
    <virtualType name="Zero\AiAssistant\Model\Tool\Sales\CancelOrder" type="Zero\AiAssistant\Model\Tool\Sales\OrderAction">
        <arguments><argument name="action" xsi:type="string">cancel</argument></arguments>
    </virtualType>
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="zero_ai_purge" xsi:type="object">Zero\AiAssistant\Console\Command\PurgeCommand</item>
            </argument>
        </arguments>
    </type>
</config>
